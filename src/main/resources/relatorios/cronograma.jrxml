<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cronograma de implantação para o cliente (módulo Projetos), sobre o timbrado oficial (logo, selo Confidencial e
  rodapé já vêm na imagem). Só etapas e datas: nunca horas, custos, divisão por analista nem observações internas.

  A página não tem margens para o timbrado cobrir a folha inteira na banda background. A área útil é garantida
  pelas bandas fixas: pageHeader de 95pt (a faixa do timbrado termina em ~66pt) e pageFooter de 90pt (o endereço
  começa em ~773pt), que repetem em todas as páginas; na horizontal, o conteúdo vai de x=40 a x=555.
-->
<jasperReport name="cronograma" language="java" pageWidth="595" pageHeight="842" columnWidth="595"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
              whenNoDataType="AllSectionsNoDetail" summaryWithPageHeaderAndFooter="true">
	<style name="Base" default="true" fontName="DejaVu Sans" fontSize="9.0" forecolor="#1F2937"/>
	<style name="Rotulo" style="Base" fontSize="7.5" forecolor="#667085"/>
	<style name="Valor" style="Base" fontSize="10.0" bold="true"/>
	<style name="Linha" style="Base">
		<conditionalStyle bold="true">
			<conditionExpression><![CDATA[$F{destaque}]]></conditionExpression>
		</conditionalStyle>
	</style>
	<parameter name="CLIENTE" class="java.lang.String"/>
	<parameter name="PROJETO" class="java.lang.String"/>
	<parameter name="INICIO" class="java.lang.String"/>
	<parameter name="TERMINO" class="java.lang.String"/>
	<parameter name="DIAS_UTEIS" class="java.lang.Integer"/>
	<parameter name="EMITIDO_EM" class="java.lang.String"/>
	<parameter name="TEM_ETAPA_CLIENTE" class="java.lang.Boolean"/>
	<field name="etapa" class="java.lang.String"/>
	<field name="quem" class="java.lang.String"/>
	<field name="inicio" class="java.lang.String"/>
	<field name="termino" class="java.lang.String"/>
	<field name="destaque" class="java.lang.Boolean"/>
	<background height="842">
		<element kind="image" x="0" y="0" width="595" height="842" scaleImage="FillFrame" hImageAlign="Center" vImageAlign="Middle">
			<expression><![CDATA["relatorios/timbrado-confidencial.jpg"]]></expression>
		</element>
	</background>
	<!-- Na 1ª página o título sai antes do pageHeader e já reserva os 95pt do topo; nas seguintes, o pageHeader. -->
	<pageHeader height="95">
		<printWhenExpression><![CDATA[$V{PAGE_NUMBER} > 1]]></printWhenExpression>
	</pageHeader>
	<title height="191">
		<element kind="staticText" x="40" y="95" width="515" height="24" fontSize="17.0" bold="true" forecolor="#222222">
			<text><![CDATA[Cronograma de implantação]]></text>
		</element>
		<element kind="textField" x="40" y="121" width="515" height="16" fontSize="10.5" forecolor="#344054" textAdjust="StretchHeight">
			<expression><![CDATA[$P{CLIENTE} + " · " + $P{PROJETO}]]></expression>
		</element>
		<element kind="staticText" x="40" y="149" width="120" height="11" style="Rotulo" positionType="Float">
			<text><![CDATA[Início]]></text>
		</element>
		<element kind="textField" x="40" y="160" width="120" height="16" style="Valor" positionType="Float">
			<expression><![CDATA[$P{INICIO}]]></expression>
		</element>
		<element kind="staticText" x="170" y="149" width="120" height="11" style="Rotulo" positionType="Float">
			<text><![CDATA[Término previsto]]></text>
		</element>
		<element kind="textField" x="170" y="160" width="120" height="16" style="Valor" positionType="Float">
			<expression><![CDATA[$P{TERMINO}]]></expression>
		</element>
		<element kind="staticText" x="300" y="149" width="120" height="11" style="Rotulo" positionType="Float">
			<text><![CDATA[Dias úteis]]></text>
		</element>
		<element kind="textField" x="300" y="160" width="120" height="16" style="Valor" positionType="Float">
			<expression><![CDATA[$P{DIAS_UTEIS}]]></expression>
		</element>
		<element kind="staticText" x="430" y="149" width="125" height="11" style="Rotulo" positionType="Float">
			<text><![CDATA[Emitido em]]></text>
		</element>
		<element kind="textField" x="430" y="160" width="125" height="16" style="Valor" positionType="Float">
			<expression><![CDATA[$P{EMITIDO_EM}]]></expression>
		</element>
	</title>
	<columnHeader height="22">
		<element kind="staticText" x="46" y="0" width="232" height="20" bold="true" vTextAlign="Middle" forecolor="#222222">
			<text><![CDATA[Etapa]]></text>
		</element>
		<element kind="staticText" x="282" y="0" width="135" height="20" bold="true" vTextAlign="Middle" forecolor="#222222">
			<text><![CDATA[Responsável]]></text>
		</element>
		<element kind="staticText" x="421" y="0" width="64" height="20" bold="true" vTextAlign="Middle" forecolor="#222222">
			<text><![CDATA[Início]]></text>
		</element>
		<element kind="staticText" x="489" y="0" width="64" height="20" bold="true" vTextAlign="Middle" forecolor="#222222">
			<text><![CDATA[Término]]></text>
		</element>
		<element kind="line" x="40" y="20" width="515" height="1">
			<pen lineWidth="1.5" lineColor="#E0512B"/>
		</element>
	</columnHeader>
	<detail>
		<band height="18">
			<element kind="textField" x="46" y="2" width="232" height="14" style="Linha" textAdjust="StretchHeight">
				<expression><![CDATA[$F{etapa}]]></expression>
			</element>
			<element kind="textField" x="282" y="2" width="135" height="14" style="Linha" textAdjust="StretchHeight">
				<expression><![CDATA[$F{quem}]]></expression>
			</element>
			<element kind="textField" x="421" y="2" width="64" height="14" style="Linha">
				<expression><![CDATA[$F{inicio}]]></expression>
			</element>
			<element kind="textField" x="489" y="2" width="64" height="14" style="Linha">
				<expression><![CDATA[$F{termino}]]></expression>
			</element>
			<element kind="line" x="40" y="17" width="515" height="1" positionType="Float">
				<pen lineWidth="0.5" lineColor="#D0D5DD"/>
			</element>
		</band>
	</detail>
	<columnFooter height="18">
		<element kind="textField" x="355" y="4" width="170" height="12" style="Rotulo" hTextAlign="Right">
			<expression><![CDATA["Página " + $V{PAGE_NUMBER}]]></expression>
		</element>
		<element kind="textField" x="525" y="4" width="30" height="12" style="Rotulo" evaluationTime="Report">
			<expression><![CDATA[" de " + $V{PAGE_NUMBER}]]></expression>
		</element>
	</columnFooter>
	<pageFooter height="90"/>
	<summary height="44">
		<element kind="textField" x="40" y="10" width="515" height="14" style="Base" fontSize="8.5" bold="true" textAdjust="StretchHeight">
			<printWhenExpression><![CDATA[$P{TEM_ETAPA_CLIENTE}]]></printWhenExpression>
			<expression><![CDATA["Etapas em negrito dependem do cliente: atrasos nelas deslocam as etapas seguintes."]]></expression>
		</element>
		<element kind="staticText" x="40" y="26" width="515" height="14" style="Base" fontSize="8.0" forecolor="#667085" positionType="Float">
			<text><![CDATA[Datas previstas, sujeitas a ajuste conforme o andamento da implantação.]]></text>
		</element>
	</summary>
</jasperReport>
