# Copie para prod.env (ignorado pelo git) e preencha.
#   docker compose -f docker-compose.prod.yml --env-file prod.env up -d

# Senha do PostgreSQL (definida na primeira subida do volume; trocar depois exige ALTER USER)
DB_PASSWORD=

# Chave da API do Gemini (Google AI Studio)
GEMINI_API_KEY=

# Segredo dos JWT, mínimo 32 caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=

# Versão das imagens brunoliragarcia/validator-backend e validator-frontend (sempre a mesma nas duas).
# Rollback = voltar a tag anterior e rodar up -d de novo.
TAG=1.2.0

# Porta do servidor onde o sistema fica acessível
HTTP_PORT=80

# Endereço que o navegador usa para abrir o sistema (liberado no CORS do backend).
# Se HTTP_PORT não for 80, inclua a porta: http://192.168.15.16:8080
CORS_ALLOWED_ORIGINS=http://192.168.15.16

# Webhook do Discord para os alertas do monitoramento (falha nas lojas, agente offline). Vazio desliga.
DISCORD_WEBHOOK_URL=
