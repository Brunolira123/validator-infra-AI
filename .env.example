# Chave da API do Gemini, do Google AI Studio (extração de dados das fotos por IA)
GEMINI_API_KEY=

# Senha do PostgreSQL. No Docker Compose também define a senha do container do banco.
DB_PASSWORD=

# Segredo de assinatura dos JWT (mínimo 32 caracteres). Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Só para rodar fora do Docker (mvn spring-boot:run). O Compose ignora estes valores para a app.
DB_HOST=localhost
DB_PORT=5432
