# Chave da API do Gemini, do Google AI Studio (extração de dados das fotos por IA)
GEMINI_API_KEY=

# Senha do PostgreSQL. No Docker Compose também define a senha do container do banco.
DB_PASSWORD=

# Segredo de assinatura dos JWT (mínimo 32 caracteres). Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Só para rodar fora do Docker (mvn spring-boot:run). O Compose ignora estes valores para a app.
DB_HOST=localhost
DB_PORT=5432

# Opcional: webhook do Discord para os alertas do monitoramento. Vazio desliga.
DISCORD_WEBHOOK_URL=

# Opcional: chave da Places API (New) do Google Cloud, para a busca de prospects do comercial.
# Vazio desliga a busca ("Busca de prospects não configurada"). Restrinja a chave só à Places API (New).
GOOGLE_PLACES_API_KEY=
# Trava de custo no app (chamadas ao Google por dia; cada categoria da busca conta 1). Padrões: 150, 150 e 30.
# GOOGLE_PLACES_LIMITE_BUSCAS=150
# GOOGLE_PLACES_LIMITE_DETALHES=150
# GOOGLE_PLACES_LIMITE_FOTOS=30
